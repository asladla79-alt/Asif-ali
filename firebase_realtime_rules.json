{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "projects": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "published_apps": {
      ".read": true,
      ".write": "auth != null"
    },
    "transactions": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "pending_payments": {
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "payment_utrs": {
      "$utr": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },
    "config": {
      "links": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
